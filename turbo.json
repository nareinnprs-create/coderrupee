{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "CODERRUPEE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "CODERRUPEE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "coderrupee#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@coderrupee/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@coderrupee/function#test": {
      "outputs": []
    },
    "@coderrupee/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@coderrupee/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@coderrupee/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
